node_modules/
dist/
.vscode-test/
.DS_Store
*.vsix

# Python cache files
__pycache__/
*.pyc
*.pyo

# Vendor directory contains reference repos for lesson authoring
# Clone repos here as needed, but don't commit them
vendor/

assets/.DS_Store

# TT-Metal model cache files (large binary files)
*.tensorbin
model_cache/
tensor_cache*/

# GitHub Pages build output (generated by npm run build:web)
site/

# Python virtual environment (machine-local, not needed in repo or .vsix)
venv/

# Lesson-registry auto-backup files (machine-local, generated on each save)
.backups/

# Vale downloaded style packages (fetched by `vale sync`, not committed)
styles/Google/

# TT-Metal inspector + watcher runtime output (written on every local run).
# Machine-local dev-box logs — they contain absolute host paths and can reach tens
# of thousands of lines. Already excluded from the .vsix via .vscodeignore; ignored
# here so local runs stop re-committing them.
generated/

