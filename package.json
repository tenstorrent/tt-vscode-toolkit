  "scripts": {
    "vscode:prepublish": "npm run clean && npm run validate:lessons && npm run validate:command-uris && webpack --mode production && npm run copy-content && npm run clean-pycache",
    "build": "npm run clean && npm run validate:lessons && npm run validate:command-uris && tsc -p ./ && npm run copy-content && npm run clean-pycache",
    "clean": "rm -rf dist/",
    "clean-pycache": "find dist -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true",
    "copy-content": "mkdir -p dist/content dist/src/webview dist/src/telemetry dist/assets/img dist/themes dist/vendor && cp -r content/lessons dist/content/ && cp -r content/templates dist/content/ && cp -r content/pages dist/content/ && cp -r content/projects dist/content/ && cp content/lesson-registry.json dist/content/ && cp -r src/webview/* dist/src/webview/ && cp src/telemetry/*.py dist/src/telemetry/ && cp -r assets/img/* dist/assets/img/ && cp -r themes/* dist/themes/ && cp node_modules/mermaid/dist/mermaid.min.js dist/vendor/",
    "watch": "tsc -watch -p ./",
    "package": "node scripts/package-extension.js",
    "compile": "tsc -p ./",
    "test": "mocha",
    "test:templates": "mocha test/lesson-tests/templates.test.ts",
    "test:links": "mocha --no-config test/link-validator.test.ts --require ts-node/register --timeout 10000",
    "test:watch": "mocha --watch",
    "docker:build": "npm run build && npm run package && podman build -t tt-vscode-toolkit:latest .",
    "docker:run": "podman run -it -p 8080:8080 -e PASSWORD=tenstorrent tt-vscode-toolkit:latest",
    "validate:lessons": "node scripts/validate-lesson-registry.js",
    "validate:command-uris": "node scripts/validate-command-uris.js",
    "lint:docs": "vale content/lessons/ content/pages/ docs/",
    "lint:docs:errors": "vale --minAlertLevel=error content/lessons/ content/pages/ docs/",
    "generate:lessons": "node scripts/generate-lesson-registry.js",
    "prebuild:web": "node scripts/check-web-deps.js",
    "build:web": "node scripts/build-web.js",
    "predev:web": "node scripts/check-web-deps.js",
    "serve:web": "node scripts/serve-dev.js",
    "dev:web": "node scripts/dev-web.js",
    "prepare": "husky install",
    "check:sim-drift": "python3 scripts/check-sim-lite-drift.py",
    "test:sim-lite": "python3 content/web/ttlang-sim-lite/test_sim_lite.py",
    "check:vendor-drift": "python3 scripts/check-vendor-drift.py",
    "check:matmul-lesson-drift": "python3 scripts/check-matmul-lesson-drift.py",
    "check:monkeypatch-drift": "python3 scripts/check-monkeypatch-drift.py"
  },
