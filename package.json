{
  "name": "tt-vscode-toolkit",
  "displayName": "TT Developer Toolkit",
  "description": "Interactive lessons, hardware monitoring, and production templates for AI silicon development",
  "version": "0.1.41",
  "icon": "dist/assets/img/marketplace-icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "publisher": "Tenstorrent",
  "repository": {
    "type": "git",
    "url": "https://github.com/tenstorrent/tt-vscode-toolkit"
  },
  "bugs": {
    "url": "https://github.com/tenstorrent/tt-vscode-toolkit/issues"
  },
  "homepage": "https://github.com/tenstorrent/tt-vscode-toolkit#readme",
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=20.9.0"
  },
  "categories": [
    "Education",
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:tenstorrentLessons",
    "onWalkthrough:tenstorrent.setup"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tenstorrent-sidebar",
          "title": "TT Toolkit",
          "icon": "dist/assets/img/tt_symbol_purple.svg"
        }
      ]
    },
    "views": {
      "tenstorrent-sidebar": [
        {
          "id": "tenstorrentLessons",
          "name": "Lessons"
        },
        {
          "id": "tenstorrentImagePreview",
          "name": "Output Preview",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "themes": [
      {
        "label": "Tenstorrent Dark",
        "uiTheme": "vs-dark",
        "path": "./dist/themes/tenstorrent-theme.json"
      },
      {
        "label": "Tenstorrent Light",
        "uiTheme": "vs",
        "path": "./dist/themes/tenstorrent-light-theme.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Tenstorrent Dark"
    },
    "configuration": {
      "title": "Tenstorrent",
      "properties": {
        "tenstorrent.showUnvalidatedLessons": {
          "type": "boolean",
          "default": true,
          "description": "Show lessons that haven't been validated on hardware yet. When enabled (default), all lessons including draft and blocked lessons are displayed. Disable to show only validated lessons in production builds."
        },
        "tenstorrent.simulatorApiUrl": {
          "type": "string",
          "default": "",
          "description": "WebSocket URL of the TT Simulator API server (e.g. ws://localhost:8080/execute). When set, the 'Run in Cloud Simulator' command streams output from this server instead of running locally."
        }
      }
    },
    "commands": [
      {
        "command": "tenstorrent.lesson.show",
        "title": "Show Lesson",
        "category": "Tenstorrent"
      },
      {
        "command": "tenstorrent.viz.tensix",
        "title": "Open Tensix Visualizer",
        "category": "Tenstorrent",
        "icon": "$(circuit-board)"
      },
      {
        "command": "tenstorrent.viz.runInCloudSimulator",
        "title": "Run in Cloud Simulator",
        "category": "Tenstorrent",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "tenstorrent.lesson.refresh",
        "title": "Refresh Lessons",
        "category": "Tenstorrent",
        "icon": "$(refresh)"
